# =====================================================
# Ty Khai TopUp - Environment Variables Configuration
# =====================================================
# Copy this file to .env and fill in your values
# =====================================================

# =====================
# Database Configuration
# =====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name?schema=public
DATABASE_URL="postgresql://your_username:your_password@localhost:5432/your_database_name?schema=public"

# =====================
# Security & Encryption
# =====================
# AES-256-GCM encryption key (minimum 32 characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your_32_character_minimum_encryption_key_here"

# Separate key for provider token encryption (optional, falls back to ENCRYPTION_KEY)
TOKEN_ENCRYPTION_KEY=""

# JWT signing secret (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET="your_32_character_minimum_jwt_secret_here"

# NextAuth secret (minimum 32 characters)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="your_32_character_minimum_nextauth_secret_here"

# NextAuth URL (your production URL)
NEXTAUTH_URL="http://localhost:3000"

# CSRF token secret (optional, falls back to JWT_SECRET)
CSRF_SECRET=""

# =====================
# Application Configuration
# =====================
# Public base URL of your application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# =====================
# Bakong Payment (Required for KHQR payments)
# =====================
# Bakong API base URL
BAKONG_API_BASE="https://api-bakong.nbc.gov.kh"

# Bakong merchant account ID (your registered email)
BAKONG_ACCOUNT="your_email@example.com"

# Bakong merchant display name
BAKONG_MERCHANT_NAME="Your Store Name"

# Bakong merchant city
BAKONG_MERCHANT_CITY="Phnom Penh"

# Bakong API token (get from Bakong portal)
# IMPORTANT: This is a JWT token - do not share it
BAKONG_TOKEN="your_bakong_jwt_token_here"

# Bakong webhook HMAC secret (for verifying webhook signatures)
# Generate with: openssl rand -hex 32
BAKONG_WEBHOOK_SECRET="your_64_character_hex_webhook_secret_here"

# Bakong IP ranges for webhook validation (comma-separated CIDR)
BAKONG_IP_RANGES=""

# =====================
# ABA PayWay (Optional)
# =====================
ABA_API_BASE="https://pay.payway.com.kh"
ABA_MERCHANT_ID=""
ABA_API_KEY=""
ABA_WEBHOOK_SECRET=""
ABA_IP_RANGES=""

# =====================
# KHPay (Optional)
# =====================
KHPAY_BASE_URL="https://khpay.site/api/v1"
KHPAY_MERCHANT_ID=""
KHPAY_API_KEY=""
KHPAY_WEBHOOK_SECRET=""

# =====================
# Game Providers
# =====================
# GameDrop API token
GAMEDROP_TOKEN=""

# G2Bulk API token
G2BULK_TOKEN=""

# =====================
# Redis (Optional - for rate limiting and queues)
# =====================
# Upstash Redis REST URL and token
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Legacy Redis URLs (if not using Upstash)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# =====================
# Telegram Notifications (Optional)
# =====================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# =====================
# Google OAuth (Optional)
# =====================
# Get from Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =====================
# Vercel Blob Storage (Optional - for file uploads)
# =====================
BLOB_READ_WRITE_TOKEN=""
